<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Start VICE-FN points VICE at the NetIEC bridge, libopencbm.dylib,
	     with DYLD_LIBRARY_PATH. Library validation stays on, so only
	     libraries signed by the same team can load. -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
</dict>
</plist>
